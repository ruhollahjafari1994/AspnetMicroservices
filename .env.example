# Copy to .env for local Docker Compose development. Replace every placeholder locally.
# Development-only credentials; never reuse them outside a local environment.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
DISCOUNT_DB_USER=replace-with-local-db-user
DISCOUNT_DB_PASSWORD=replace-with-a-strong-local-password
RABBITMQ_USER=replace-with-local-rabbit-user
RABBITMQ_PASSWORD=replace-with-a-strong-local-password
WEB_OIDC_CLIENT_SECRET=replace-with-a-random-local-client-secret
BASKET_OIDC_CLIENT_SECRET=replace-with-a-random-local-client-secret
IDENTITY_BOOTSTRAP_ADMIN_USERNAME=admin
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=replace-with-a-strong-local-password

# Production deployments must use HTTPS issuer/authority URLs and a secret manager.
# Do not set Identity__RequireHttpsMetadata=false or use the Docker HTTP issuer in production.
